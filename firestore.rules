rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== HELPER FUNCTIONS ==========
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isMemberOf(orgId) {
      return exists(/databases/$(database)/documents/userOrganizations/$(request.auth.uid + '_' + orgId));
    }
    
    function getMembership(orgId) {
      return get(/databases/$(database)/documents/userOrganizations/$(request.auth.uid + '_' + orgId)).data;
    }
    
    function hasRole(orgId, allowedRoles) {
      let membership = getMembership(orgId);
      return membership.role in allowedRoles;
    }
    
    // Super-admin de plataforma (custom claim emitido por Cloud Function)
    function isPlatformAdmin() {
      return isAuthenticated() && request.auth.token.platformAdmin == true;
    }
    
    // ========== USERS ==========
    
    match /users/{userId} {
      // Todos usuários autenticados podem ler perfis (para exibir nomes, fotos)
      allow read: if isAuthenticated();

      // Apenas o próprio usuário pode escrever seu perfil
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // ========== PREFERÊNCIAS DE USUÁRIO ==========
    // Corrige lacuna anterior: esta coleção nunca teve regra própria, então
    // toda leitura/escrita caía no default-deny do Firestore. Na prática,
    // preferências (ordenação, colunas, densidade, visões salvas etc.) só
    // persistiam via localStorage — nunca sincronizavam entre dispositivos.
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    // ========== ORGANIZATIONS ==========
    
    match /organizations/{orgId} {
      // Apenas membros da organização podem ler
      allow read: if isAuthenticated() && isMemberOf(orgId);

      // Escrita exclusiva de Cloud Functions (createOrganization/updateOrganization/
      // deleteOrganization). Motivo: o cliente já não escreve mais aqui
      // diretamente (todo o fluxo de criação/edição/exclusão foi migrado para
      // Cloud Functions há tempos — as funções antigas em firestoreService.js
      // que faziam isso são código morto, sem nenhum ponto de chamada). Um
      // "allow update" direto permitiria a qualquer admin/creator sobrescrever
      // campos reservados ao criador (retentionConfig, webhookConfig etc. —
      // validados só dentro de updateOrganization) e um "allow delete" direto
      // apagaria o órgão sem a confirmação de nome e sem limpar as coleções
      // dependentes (só feito dentro de deleteOrganization).
      allow create, update, delete: if false;
    }

    // ========== USER ORGANIZATIONS (Memberships) ==========

    match /userOrganizations/{membershipId} {
      // Leitura restrita ao próprio vínculo ou a vínculos de um órgão do qual
      // o solicitante já é membro — antes qualquer usuário autenticado podia
      // listar a coleção inteira e colher organization_id/user_email/role de
      // TODOS os órgãos da plataforma (vazamento de dados entre órgãos).
      allow read: if isAuthenticated() && (
        isOwner(resource.data.user_id) || isMemberOf(resource.data.organization_id)
      );

      // Escrita exclusiva de Cloud Functions (createOrganization/joinOrganization/
      // updateMember/removeMember). Antes, "allow create: if isAuthenticated()"
      // sem nenhuma validação de campos permitia a QUALQUER usuário autenticado
      // criar seu próprio vínculo com role:'creator' em qualquer organization_id
      // que conhecesse — acesso total a um órgão alheio sem convite nenhum. E o
      // "allow update" pelo próprio dono deixava o usuário reescrever seu
      // próprio role/permissions livremente. As funções client-side
      // equivalentes em firestoreService.js (createMembership,
      // updateMembershipRole, joinOrganizationByInvite) são código morto, sem
      // nenhum ponto de chamada no app.
      allow create, update, delete: if false;
    }
    
    // ========== PROCESSES ==========
    
    match /processes/{processId} {
      // Membros da organização podem ler processos
      allow read: if isAuthenticated() && isMemberOf(resource.data.organization_id);
      
      // Membros podem criar processos
      allow create: if isAuthenticated() && 
                      isMemberOf(request.resource.data.organization_id);
      
      // Pode atualizar se for:
      // 1. Admin/creator da organização, OU
      // 2. Responsável pelo processo
      // Em ambos os casos, organization_id não pode mudar na própria escrita —
      // sem isto, quem tem permissão de editar poderia "mover" o processo para
      // outro órgão (inclusive um controlado por ele) trocando só esse campo.
      allow update: if isAuthenticated() &&
                      isMemberOf(resource.data.organization_id) && (
                        hasRole(resource.data.organization_id, ['creator', 'admin']) ||
                        isOwner(resource.data.responsible_user_id)
                      ) &&
                      request.resource.data.organization_id == resource.data.organization_id;
      
      // Apenas admin/creator podem deletar
      allow delete: if isAuthenticated() && 
                      isMemberOf(resource.data.organization_id) &&
                      hasRole(resource.data.organization_id, ['creator', 'admin']);

      // Subcoleção de histórico (Fase 3). Leitura para membros do órgão do
      // processo pai; escrita exclusiva de Cloud Functions (Admin SDK).
      match /history/{entryId} {
        allow read: if isAuthenticated() &&
          isMemberOf(get(/databases/$(database)/documents/processes/$(processId)).data.organization_id);
        allow write: if false;
      }

      // Comentários internos com @menção (flag `process_comments`). Leitura
      // para membros do órgão do processo pai; escrita exclusiva da Cloud
      // Function addComment (valida associação e notifica os mencionados).
      match /comments/{commentId} {
        allow read: if isAuthenticated() &&
          isMemberOf(get(/databases/$(database)/documents/processes/$(processId)).data.organization_id);
        allow write: if false;
      }
    }

    // ========== EXPEDIENTES ADMINISTRATIVOS ==========
    
    match /expedientes/{expedienteId} {
      // Membros da organização podem ler expedientes
      allow read: if isAuthenticated() && isMemberOf(resource.data.organization_id);
      
      // Membros podem criar expedientes
      allow create: if isAuthenticated() && 
                      isMemberOf(request.resource.data.organization_id);
      
      // Pode atualizar se for:
      // 1. Admin/creator da organização, OU
      // 2. Responsável pelo expediente
      // organization_id não pode mudar na própria escrita (mesma razão da
      // regra equivalente em processes/{id}).
      allow update: if isAuthenticated() &&
                      isMemberOf(resource.data.organization_id) && (
                        hasRole(resource.data.organization_id, ['creator', 'admin']) ||
                        isOwner(resource.data.responsible_user_id)
                      ) &&
                      request.resource.data.organization_id == resource.data.organization_id;
      
      // Apenas admin/creator podem deletar
      allow delete: if isAuthenticated() && 
                      isMemberOf(resource.data.organization_id) &&
                      hasRole(resource.data.organization_id, ['creator', 'admin']);

      // Subcoleção de histórico (Fase 3). Leitura para membros do órgão do
      // expediente pai; escrita exclusiva de Cloud Functions (Admin SDK).
      match /history/{entryId} {
        allow read: if isAuthenticated() &&
          isMemberOf(get(/databases/$(database)/documents/expedientes/$(expedienteId)).data.organization_id);
        allow write: if false;
      }

      // Comentários internos com @menção (flag `process_comments`). Mesma
      // lógica da subcoleção equivalente em processes/{id}/comments.
      match /comments/{commentId} {
        allow read: if isAuthenticated() &&
          isMemberOf(get(/databases/$(database)/documents/expedientes/$(expedienteId)).data.organization_id);
        allow write: if false;
      }
    }

    // ========== PÁGINAS/PROCESSOS PERSONALIZADOS (flag: custom_entities) ==========
    // Definições dos tipos de entidade. Leitura para membros do órgão; toda
    // escrita passa por Cloud Functions (validação/sanitização no servidor).
    match /entityTypes/{typeId} {
      allow read: if isAuthenticated() && isMemberOf(resource.data.organization_id);
      allow write: if false;
    }

    // Registros das páginas personalizadas. Leitura para membros do órgão;
    // criação/edição/exclusão exclusivamente via Cloud Functions.
    match /customRecords/{recordId} {
      allow read: if isAuthenticated() && isMemberOf(resource.data.organization_id);
      allow write: if false;

      // Histórico espelhado (igual a processes/expedientes).
      match /history/{entryId} {
        allow read: if isAuthenticated() &&
          isMemberOf(get(/databases/$(database)/documents/customRecords/$(recordId)).data.organization_id);
        allow write: if false;
      }
    }
    
    // ========== AUDIT LOGS ==========
    
    match /auditLogs/{logId} {
      // Membros podem ler logs da organização
      allow read: if isAuthenticated() && isMemberOf(resource.data.organization_id);
      
      // NINGUÉM pode escrever diretamente - apenas Cloud Functions
      allow write: if false;
    }
    
    // ========== CÓDIGOS DE VERIFICAÇÃO (flag `two_factor_auth`) ==========
    // otpCodes/{uid}: código de 2FA por e-mail, com hash (nunca texto puro) e
    // expiração curta. Acesso EXCLUSIVO das Cloud Functions sendLoginOtp/
    // verifyLoginOtp (Admin SDK) — nenhuma leitura ou escrita do cliente.
    match /otpCodes/{uid} {
      allow read, write: if false;
    }

    // ========== PRESENÇA EM TEMPO REAL (flag `live_presence`) ==========
    // Heartbeats efêmeros (id determinístico `${entityType}_${entityId}_${uid}`).
    // Escrita direta do cliente (sem Cloud Function): cada usuário só grava/apaga
    // o PRÓPRIO heartbeat, e só dentro de um órgão do qual é membro. Leitura
    // liberada para membros do órgão para exibir "quem está vendo" o registro.

    match /presence/{presenceId} {
      allow read: if isAuthenticated() && isMemberOf(resource.data.organization_id);

      allow create: if isAuthenticated() &&
                      isOwner(request.resource.data.user_id) &&
                      isMemberOf(request.resource.data.organization_id);

      // update também exige ser dono do doc JÁ EXISTENTE (não só da nova
      // versão) — evita que alguém reescreva o heartbeat de outro usuário.
      allow update: if isAuthenticated() &&
                      isOwner(resource.data.user_id) &&
                      isOwner(request.resource.data.user_id) &&
                      isMemberOf(request.resource.data.organization_id);

      allow delete: if isAuthenticated() && isOwner(resource.data.user_id);
    }

    // ========== NOTIFICATIONS ==========
    
    match /notifications/{notifId} {
      // Apenas o destinatário pode ler suas notificações
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      
      // Pode atualizar apenas para marcar como lida
      allow update: if isAuthenticated() && 
                      isOwner(resource.data.user_id) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['read', 'read_at']);
      
      // Não pode criar/deletar - apenas Cloud Functions
      allow create, delete: if false;
    }

    // ========== PLATAFORMA: CONFIG / FEATURE FLAGS ==========

    match /platformConfig/{docId} {
      // Qualquer usuário autenticado pode LER as flags (controlam o comportamento
      // do app para todos). São apenas valores booleanos, não sensíveis.
      allow read: if isAuthenticated();

      // Escrita exclusiva de Cloud Functions (setFeatureFlag valida super-admin).
      allow write: if false;
    }

    // ========== PLATAFORMA: ALLOWLIST DE SUPER-ADMINS ==========

    match /platformAdmins/{uid} {
      // O próprio usuário pode ler seu registro (para o app saber se é admin),
      // e super-admins podem ler todos.
      allow read: if isAuthenticated() && (isOwner(uid) || isPlatformAdmin());

      // Escrita exclusiva de Cloud Functions (grant/revoke validam super-admin).
      allow write: if false;
    }

    // ========== PLATAFORMA: ESTATÍSTICAS AGREGADAS ==========

    match /platformStats/{docId} {
      // Apenas super-admin lê estatísticas globais.
      allow read: if isPlatformAdmin();

      // Escrita exclusiva de Cloud Functions (cron/agregadores).
      allow write: if false;
    }
  }
}
