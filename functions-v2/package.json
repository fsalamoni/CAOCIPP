{
    "name": "sigo-functions",
    "version": "1.0.0",
    "main": "lib/index.js",
    "engines": {
        "node": "22"
    },
    "dependencies": {
        "@google-cloud/bigquery": "^7.9.0",
        "firebase-admin": "^13.8.0",
        "firebase-functions": "^7.2.5",
        "pdf-lib": "^1.17.1",
        "pdfmake": "^0.2.20",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/pdfmake": "^0.2.13",
        "firebase-functions-test": "^3.1.0",
        "typescript": "^5.3.0"
    },
    "scripts": {
        "build:local": "tsc",
        "test": "tsc && node --test test/*.test.js",
        "serve": "npm run build:local && firebase emulators:start --only functions",
        "shell": "npm run build:local && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    }
}
