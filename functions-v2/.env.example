# Modelo de configuração das Cloud Functions — copie para `.env` (git-ignorado)
# para rodar localmente com os emuladores. Em produção, essas mesmas variáveis
# são geradas automaticamente pelo workflow de deploy a partir dos secrets do
# GitHub Actions (ver .github/workflows/deploy.yml e, dentro do app,
# Administração & Custos → aba Configuração). Nenhuma delas é obrigatória —
# sem elas, a funcionalidade correspondente fica graciosamente inativa.

# Chave da API do Resend (e-mail transacional: 2FA, resumo diário e relatório
# semanal por e-mail). Obtida em https://resend.com após verificar um domínio.
EMAIL_API_KEY=

# E-mails (separados por vírgula) com acesso de super-admin garantido, mesmo
# sem registro em platformAdmins/{uid} no Firestore. Só serve como bootstrap;
# no dia a dia, use a aba Administradores dentro do app.
PLATFORM_ADMIN_EMAILS=

# Export do Cloud Billing para o BigQuery (custos reais na aba Admin → Custos).
# Sem eles, a aba mostra uma estimativa em vez do valor exato cobrado.
BILLING_BQ_PROJECT=
BILLING_BQ_DATASET=
BILLING_BQ_TABLE=
